# Binaries & build output
/bin/
/dist/
*.exe
*.out
*.test
*.wasm

# Compiled commands. `go build ./cmd/obgw` drops its binary in the working
# directory, not in /bin, and obgw was tracked that way for months -- a 9 MB
# blob per rebuild in a repository whose source is a few hundred KB. Listed by
# name because these have no extension to match on.
/obgw
/obdash
/obdemo
/obmm
/obsoak
/obwasm
/surveil
/ofistudy
/lambdastudy
/flowstudy
/l2capture

# Coverage / profiling
coverage.out
coverage.html
*.prof
cpu.pprof
mem.pprof

# Go workspace
go.work
go.work.sum

# Knowledge-graph passes over the repository (regenerated, ~10 MB)
graphify-out/

# Web (arrives with the demo milestone)
web/node_modules/
web/dist/
web/.vite/
# Generated at deploy time (Go toolchain + WASM build)
web/wasm_exec.js
web/obook.wasm

